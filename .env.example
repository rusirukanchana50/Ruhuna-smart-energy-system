# ==============================================================================
# University of Ruhuna - Faculty of Engineering
# Smart Energy Monitoring and Analytics System
# Environment Configuration Template (.env.example)
# ==============================================================================

# 1. Flask Security Configuration
# (Optional) Provide a custom private 256-bit cryptographic hex key for session signing.
# If omitted or not set, app.py automatically generates and safely persists a 256-bit
# secure key inside the local git-ignored `.secret_key` file.
FLASK_SECRET_KEY=your-custom-production-secret-key-here-minimum-32-chars

# 2. Simulator Configuration
# Default telemetry sampling interval in seconds (default: 15.0)
SIMULATOR_INTERVAL=15.0

# 3. Electrical Safety Thresholds
# Power factor warning threshold (default: 0.85)
THRESHOLD_PF_LOW=0.85

# Line voltage thresholds in Volts line-to-line (Nominal: 400.0V ±5%)
THRESHOLD_VOLTAGE_MIN=380.0
THRESHOLD_VOLTAGE_MAX=420.0

# Grid frequency thresholds in Hertz (Nominal: 50.0Hz ±1%)
THRESHOLD_FREQ_MIN=49.5
THRESHOLD_FREQ_MAX=50.5

# High electrical load warning threshold ratio (0.90 = 90% of building rated capacity)
THRESHOLD_HIGH_LOAD_RATIO=0.90

# Telemetry sensor timeout silence threshold in seconds (default: 60.0)
THRESHOLD_SENSOR_OFFLINE=60.0

# NOTE:
# - Demonstration tariff and faculty standard operating hours (08:00–17:00 weekdays)
#   are stored dynamically in the SQLite database (`energy.db`) and can be adjusted
#   directly through the web interface (/reports -> Demonstration Tariff modal)
#   or via database.py / configure_system.py utilities.
